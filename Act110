import pygame
import random

pygame.init()

SPRITE_COLOR_CHANGE_EVENT = pygame.USEREVENT + 1
BACKGROUND_COLOR_CHANGE_EVENT = pygame.USEREVENT + 2

BLUE = pygame.Color("blue")
LIGHTBLUE = pygame.Color("lightblue")
DARKBLUE = pygame.Color("darkblue")

YELLOW = pygame.Color("yellow")
MAGENTA = pygame.Color("magenta")
ORANGE = pygame.Color("orange")
WHITE = pygame.Color("white")

background_colors = [BLUE, LIGHTBLUE, DARKBLUE]
sprite_colors = [YELLOW, MAGENTA, ORANGE, WHITE]


class Sprite(pygame.sprite.Sprite):
    def __init__(self, color, width, height):
        super().__init__()

        self.image = pygame.Surface([width, height])
        self.image.fill(color)

        self.rect = self.image.get_rect()

        self.velocity = [
            random.choice([-1, 1]),
            random.choice([-1, 1])
        ]

    def update(self):

        self.rect.move_ip(self.velocity)

        boundary_touched = False

        if self.rect.left <= 0 or self.rect.right >= 500:
            self.velocity[0] = -self.velocity[0]
            boundary_touched = True

        if self.rect.top <= 0 or self.rect.bottom >= 400:
            self.velocity[1] = -self.velocity[1]
            boundary_touched = True
        if boundary_touched:
            pygame.event.post(
                pygame.event.Event(SPRITE_COLOR_CHANGE_EVENT)
            )

            pygame.event.post(
                pygame.event.Event(BACKGROUND_COLOR_CHANGE_EVENT)
            )
    def change_color(self):
        self.image.fill(random.choice(sprite_colors))


def change_background_color():
    return random.choice(background_colors)

all_sprites_list = pygame.sprite.Group()

sp1 = Sprite(YELLOW, 50, 50)

sp1.rect.x = random.randint(0, 450)
sp1.rect.y = random.randint(0, 350)

all_sprites_list.add(sp1)

screen = pygame.display.set_mode((500, 400))
pygame.display.set_caption("Bouncing Color Sprite")

background_color = BLUE
screen.fill(background_color)

clock = pygame.time.Clock()
running = True

while running:

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        elif event.type == SPRITE_COLOR_CHANGE_EVENT:
            sp1.change_color()

        elif event.type == BACKGROUND_COLOR_CHANGE_EVENT:
            background_color = change_background_color()

    all_sprites_list.update()

    screen.fill(background_color)

    all_sprites_list.draw(screen)

    pygame.display.flip()

    clock.tick(240)

pygame.quit()